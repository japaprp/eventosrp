{
  "rules": {
    ".read": false,
    ".write": false,
    "chats": {
      "$reservationId": {
        "messages": {
          ".read": "auth != null && root.child('chats').child($reservationId).child('members').child(auth.uid).val() === true",
          "$messageId": {
            ".write": "auth != null && !data.exists() && root.child('chats').child($reservationId).child('members').child(auth.uid).val() === true",
            ".validate": "newData.hasChildren(['sender', 'text', 'createdAt'])",
            "sender": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
