{"rules":{".read":false,".write":false,"chats":{"$reservation":{"members":{".read":"auth != null && (data.child(auth.uid).val() === true || auth.token.admin === true)",".write":false},"messages":{".read":"auth != null && (root.child('chats').child($reservation).child('members').child(auth.uid).val() === true || auth.token.admin === true)","$message":{".write":"auth != null && !data.exists() && (root.child('chats').child($reservation).child('members').child(auth.uid).val() === true || auth.token.admin === true)",".validate":"newData.hasChildren(['sender', 'text', 'createdAt'])","sender":{".validate":"newData.isString() && newData.val() === auth.uid"},"text":{".validate":"newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"},"createdAt":{".validate":"newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"},"$other":{".validate":false}}}}}}}
